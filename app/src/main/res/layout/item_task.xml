<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_task"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/background_task_item"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@android:color/transparent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- Barra de prioridad lateral -->
        <View
            android:id="@+id/view_priority_bar"
            android:layout_width="3dp"
            android:layout_height="0dp"
            android:background="@color/eco_green_primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Marcar tarea como completada -->
        <CheckBox
            android:id="@+id/cb_completada"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            app:buttonTint="@color/eco_green_primary"
            app:layout_constraintStart_toEndOf="@id/view_priority_bar"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Nombre de la tarea -->
        <TextView
            android:id="@+id/tv_task_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Nombre de la tarea"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            app:layout_constraintStart_toEndOf="@id/cb_completada"
            app:layout_constraintEnd_toStartOf="@id/iv_alert_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/pb_subtareas"
            app:layout_constraintVertical_chainStyle="packed" />

        <!-- Icono de alerta para inconclusas -->
        <ImageView
            android:id="@+id/iv_alert_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="4dp"
            android:src="@android:drawable/stat_sys_warning"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@id/chip_auto"
            app:layout_constraintTop_toTopOf="@id/tv_task_name"
            app:layout_constraintBottom_toBottomOf="@id/tv_task_name"
            app:tint="#FF5252" />

        <!-- Barra de progreso de subtareas -->
        <ProgressBar
            android:id="@+id/pb_subtareas"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="16dp"
            android:progressDrawable="@drawable/bg_progress_task"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@id/cb_completada"
            app:layout_constraintEnd_toStartOf="@id/chip_auto"
            app:layout_constraintTop_toBottomOf="@id/tv_task_name"
            app:layout_constraintBottom_toTopOf="@id/tv_due_date" />

        <!-- Fecha límite -->
        <TextView
            android:id="@+id/tv_due_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="2dp"
            android:text="Terminar para: --/--/----"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@id/cb_completada"
            app:layout_constraintEnd_toStartOf="@id/chip_auto"
            app:layout_constraintTop_toBottomOf="@id/pb_subtareas"
            app:layout_constraintBottom_toTopOf="@id/tv_task_time" />

        <!-- Hora de la tarea -->
        <TextView
            android:id="@+id/tv_task_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="2dp"
            android:text="00:00 AM"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp"
            app:layout_constraintStart_toEndOf="@id/cb_completada"
            app:layout_constraintEnd_toStartOf="@id/chip_auto"
            app:layout_constraintTop_toBottomOf="@id/tv_due_date"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Badge "Auto-programada" (se oculta si no aplica) -->
        <TextView
            android:id="@+id/chip_auto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Continuar"
            android:textColor="@color/eco_green_badge_text"
            android:textSize="10sp"
            android:textAlignment="center"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/bg_badge_green"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@id/btn_menu"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Menú de opciones (tres puntos) -->
        <ImageButton
            android:id="@+id/btn_menu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Opciones"
            android:src="@drawable/ic_more_vert"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:tint="@color/text_secondary" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
